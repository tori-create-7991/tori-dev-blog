# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

public_dev
_local-folder

# コンテンツの下書き（公開リポジトリなので git に載せない。README だけ管理する）
# ADR 0004 改訂節参照
content/posts/drafts/*
!content/posts/drafts/README.md
content/feed/drafts/*
!content/feed/drafts/README.md

# Terraform
# terraform.tfvars は秘密を含まない設定値なのでコミットする。
# 秘密を含む変数ファイルは *.auto.tfvars か secret*.tfvars にしてコミットしない。
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.auto.tfvars
terraform/**/secret*.tfvars
terraform/**/crash.log
