{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "static-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "tcp://127.0.0.1:4173",
        ".output/public"
      ],
      "port": 4173,
      "url": "http://127.0.0.1:4173"
    }
  ]
}
